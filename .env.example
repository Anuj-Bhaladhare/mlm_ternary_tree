DATABASE_URL=postgresql://mlm_user:mlm_management_123@localhost:5432/mlm_management
POSTGRES_USER=mlm_user
POSTGRES_PASSWORD=mlm_management_123
POSTGRES_DB=mlm_management
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters-before-use
BETTER_AUTH_URL=http://localhost:3000
# Required for ADMIN registration. Use at least 16 random characters and keep
# the real value private; it is only validated and used on the server.
ADMIN_CREATION_KEY=replace-with-a-strong-random-secret-of-at-least-16-characters
# Optional: uncomment and configure both to provision an administrator at startup.
# The account is created only when no matching email exists; existing passwords
# are never changed. Keep the password private and do not commit real credentials.
# APP_ADMIN_USER=admin@example.com
# APP_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
# Predefined administrator bootstrap. Generate a different 32+ character
# random ADMIN_SETUP_TOKEN for every environment and deliver it out-of-band.
ADMIN_ID=ADMIN001
ADMIN_EMAIL=admin@example.com
ADMIN_SETUP_TOKEN=replace-with-a-random-32-character-or-longer-bootstrap-secret

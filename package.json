{
  "name": "mlm_binary_tree",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/server/db/migrate.ts",
    "db:seed": "tsx --env-file=.env src/server/db/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:bootstrap-admin": "tsx --env-file=.env src/server/db/bootstrap-admin.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.10",
    "better-auth": "^1.7.10",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.468.0",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tsx": "^4.20.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
